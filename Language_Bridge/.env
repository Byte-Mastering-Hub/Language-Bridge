# Language Bridge — environment variables
# Copy this file to .env and fill in the values.

# ── Facebook/Meta translation model ──────────────────────────────────────────
# Set this to the folder where your downloaded model is saved.
# Supported: NLLB-200 (facebook/nllb-200-distilled-600M or -1.3B)
#            M2M-100  (facebook/m2m100_418M or facebook/m2m100_1.2B)
#            mBART    (facebook/mbart-large-50-many-to-many-mmt)
#
# Example (Windows):
#   TRANSLATION_MODEL_PATH=C:/models/nllb-200-distilled-600M
# Example (relative path inside project):
#   TRANSLATION_MODEL_PATH=models/nllb-200-distilled-600M
#
# Leave empty to use the built-in Google Translate fallback (no install needed).
TRANSLATION_MODEL_PATH=

# Device to run the model on: cpu  or  cuda  (if you have a GPU)
TRANSLATION_DEVICE=cpu

# ── Server ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
PORT=5000
